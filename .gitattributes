# Vendored lm-detector sources must stay byte-identical to upstream so the
# provenance SHA256 checks keep proving parity; their whitespace is upstream's.
detector/upstream/** -whitespace
detector/shared_detector.bin -whitespace -diff
detector/fixtures/** -whitespace

# Byte-identical provenance files must never undergo checkout CRLF conversion.
detector/upstream/** -text
detector/shared_detector.bin -text
detector/LICENSE -text
detector/fixtures/** -text
